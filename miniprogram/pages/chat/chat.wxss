.chat-page { display: flex; flex-direction: column; height: 100vh; background: #f5f6f7; }
.messages { flex: 1; padding: 20rpx 24rpx; box-sizing: border-box; overflow-y: auto; }
.chips { display: flex; flex-wrap: wrap; gap: 14rpx; margin-bottom: 20rpx; }
.chip { background: #e8f5e9; color: #1e8e3e; border-radius: 28rpx; padding: 10rpx 26rpx; font-size: 24rpx; }
.msg-row { margin-bottom: 20rpx; }
.msg-row.right { display: flex; justify-content: flex-end; }
.bubble { max-width: 80%; padding: 20rpx 26rpx; border-radius: 20rpx; font-size: 28rpx; line-height: 1.6; word-break: break-all; }
.bubble.user { background: linear-gradient(135deg, #1e8e3e, #43a047); color: #fff; border-bottom-right-radius: 6rpx; }
.bubble.bot { background: #fff; color: #333; border-bottom-left-radius: 6rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,.05); }
.srcs { margin-top: 8rpx; }
.src { color: #999; font-size: 22rpx; margin-top: 4rpx; }
.fb { margin-top: 8rpx; }
.fb-btn { color: #1e8e3e; font-size: 24rpx; margin-right: 24rpx; }
.input-bar { display: flex; align-items: center; gap: 16rpx; padding: 16rpx 24rpx; background: #fff; border-top: 1rpx solid #eee; }
.chat-input { flex: 1; background: #f2f3f5; border-radius: 36rpx; padding: 18rpx 28rpx; font-size: 28rpx; }
.send-btn { margin: 0; flex-shrink: 0; background: linear-gradient(135deg, #1e8e3e, #43a047); color: #fff; border-radius: 36rpx; padding: 0 34rpx; font-size: 28rpx; line-height: 72rpx; height: 72rpx; }
.send-btn::after { border: none; }