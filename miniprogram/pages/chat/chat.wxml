<view class="chat-page">
  <scroll-view class="messages" scroll-y>
    <view class="chips">
      <view class="chip" wx:for="{{examples}}" wx:key="*this" data-q="{{item}}" bindtap="onExample">{{item}}</view>
    </view>
    <view class="msg-row {{item.role === 'user' ? 'right' : 'left'}}" wx:for="{{messages}}" wx:key="index">
      <view class="bubble {{item.role === 'user' ? 'user' : 'bot'}}">{{item.content}}</view>
      <view wx:if="{{item.role !== 'user' && item.offline}}" class="tag">离线回答</view>
      <view wx:if="{{item.role !== 'user'}}" class="srcs">
        <view class="src" wx:for="{{item.sources}}" wx:for-item="src" wx:key="docId">[来源:{{src.title}}]</view>
        <view wx:if="{{item.messageId}}" class="fb">
          <text class="fb-btn" data-id="{{item.messageId}}" data-fb="UP" bindtap="onFeedback">👍 有用</text>
          <text class="fb-btn" data-id="{{item.messageId}}" data-fb="DOWN" bindtap="onFeedback">👎 没用</text>
        </view>
      </view>
    </view>
  </scroll-view>
  <view class="input-bar">
    <input class="chat-input" placeholder="请输入问题…" value="{{input}}" bindinput="onInput" confirm-type="send" bindconfirm="onSend" />
    <button class="send-btn" bindtap="onSend">发送</button>
  </view>
</view>