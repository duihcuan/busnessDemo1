<view class="card">
  <view class="section-title">{{product.name}}</view>
  <view class="price">¥{{product.price}}</view>
  <view class="tag">{{product.specText}}</view>
  <view>库存 {{product.stock}} | 产地 {{product.origin}}</view>
  <view>溯源编号：{{product.traceCode}}</view>
  <button bindtap="goTrace">查看溯源</button>
  <view>数量</view>
  <input class="input" type="number" value="{{qty}}" bindinput="onQty" />
</view>
<view style="display:flex; gap:16rpx; padding:20rpx;">
  <button bindtap="onAddCart">加入购物车</button>
  <button class="btn-primary" bindtap="onBuy">立即购买</button>
</view>
