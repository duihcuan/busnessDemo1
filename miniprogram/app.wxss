page { background: #f5f6f7; font-size: 28rpx; color: #333; font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif; }
.page { min-height: 100vh; padding-bottom: 40rpx; }
.card { background: #fff; border-radius: 20rpx; padding: 28rpx; margin: 24rpx; box-shadow: 0 4rpx 16rpx rgba(0,0,0,.04); }
.btn-primary { background: linear-gradient(135deg, #1e8e3e, #43a047); color: #fff; border-radius: 44rpx; border: none; }
.btn-primary::after { border: none; }
.price { color: #e64340; font-weight: 700; font-size: 32rpx; }
.tag { display: inline-block; background: #e8f5e9; color: #1e8e3e; border-radius: 8rpx; padding: 4rpx 14rpx; font-size: 22rpx; margin-right: 10rpx; }
.section-title { font-size: 32rpx; font-weight: 700; margin-bottom: 20rpx; }
.input { border: 2rpx solid #e5e5e5; border-radius: 14rpx; padding: 18rpx 22rpx; margin: 14rpx 0; background: #fff; }
button { margin-top: 16rpx; }